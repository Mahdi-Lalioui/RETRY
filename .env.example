# Copy to .env.local (git-ignored). Never commit real keys.

# --- Mubit (fill from kickoff) ---
MUBIT_ENABLED=false                # mock rehearsal by default; true enables real configured inference
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1 # documented OpenAI provider proxy
MUBIT_API_KEY=                     # mbt_ key from Mubit console, never an OpenAI sk- key
MUBIT_PROVIDER_KEY_HEADER=         # custom integrations only; public Mubit forbids forwarding provider keys
MUBIT_REQUEST_ID_HEADER=x-middleware-request-id
MUBIT_FEEDBACK_URL=                # requires confirmed hackathon correction API; not in public API docs
MUBIT_REFRESH_URL=                 # requires confirmed training API; public training is console-managed
MUBIT_VERSIONS_URL=                # requires confirmed version API; unset cannot track updates
MUBIT_VERSION_MODE=model_suffix    # custom adapter APIs only: model_suffix | header | console_pin
MUBIT_VERSION_SUFFIX_SEP=@         # TODO(MUBIT) model_suffix syntax: `${model}${sep}${versionId}`
MUBIT_VERSION_HEADER=              # if header mode
MUBIT_SUPPORTS_JSON_MODE=true
MUBIT_SUPPORTS_METADATA=false
MUBIT_CHAT_TIMEOUT_MS=20000
MUBIT_OTHER_TIMEOUT_MS=10000
MUBIT_EST_TRAIN_SECONDS=120        # used for "est." ring progress when Mubit gives none
MUBIT_MEMORY_FALLBACK=false
MUBIT_ENDPOINT=https://api.mubit.ai   # memory/control plane (fallback only): /v2/control/step_outcome, /v2/control/outcome

# --- Models ---
OPEN_BASE_MODEL=                   # configure a served open model; 'open-base' is mock-only
CLOSED_MODEL=gpt-4o-mini           # baseline; confirm current model + price on the day
OPENAI_API_KEY=                    # optional local provider credential; add it in Mubit console for public proxy

# --- App ---
DATABASE_URL=                      # Neon via Vercel Marketplace; unset → in-memory store
DEMO_MODE=false
MAX_STEPS=16
REFRESH_MIN_EXAMPLES=40
EVAL_CONCURRENCY=4
SEND_ACCEPTED=false
REVEAL_R7_AT=6
NEXT_PUBLIC_DEFAULT_SEED=9001
ICL_MAX_EXAMPLES=400

# --- Mock client (dev / rehearsal / tests only) ---
MOCK_LATENCY_SCALE=1               # 0 = no simulated latency (tests)
MOCK_TRAIN_SECONDS=12              # simulated refresh duration

# Hybrid stage mode: keep MUBIT_ENABLED=false (learning loop simulated) but route these lanes through REAL Mubit.
# Needs MUBIT_BASE_URL + MUBIT_API_KEY. Step log shows the real mreq_ request id; pill reads "GPT LIVE VIA MUBIT".
MUBIT_LIVE_LANES=closed
MUBIT_REQUEST_ID_HEADER=x-middleware-request-id
